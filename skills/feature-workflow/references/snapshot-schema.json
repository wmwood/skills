            "$ref": "#/$defs/diagnostic"
          }
        }
      },
      "required": [
        "id",
        "repository_id",
        "workspace_id",
        "feature_id",
        "source_id",
        "availability",
        "lifecycle",
        "phases",
        "tasks",
        "blockers",
        "feedback",
        "assignments",
        "activity",
        "reviews",
        "integration",
        "gates",
        "pr",
        "cleanup",
        "artifacts",
        "unavailable",
        "diagnostics"
      ],
      "additionalProperties": true
    },
    "config": {
      "type": "object",
      "properties": {
        "config_version": {
          "$ref": "#/$defs/version"
        },
        "repositories": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/identifier"
              },
              "path": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "path"
            ],
            "additionalProperties": true
          }
        },
        "workspace_roots": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/identifier"
              },
              "repository_id": {
                "$ref": "#/$defs/identifier"
              },
              "path": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "repository_id",
              "path"
            ],
            "additionalProperties": true
          }
        },
        "workspaces": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/identifier"
              },
              "repository_id": {
                "$ref": "#/$defs/identifier"
              },
              "path": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "repository_id",
              "path"
            ],
            "additionalProperties": true
          }
        },
        "freshness_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_read_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        }
      },
      "required": [
        "config_version",
        "repositories"
      ],
      "additionalProperties": true
    },
    "eligibility": {
      "type": "object",
      "properties": {
        "spec_revision": {
          "type": "integer",
          "minimum": 1
        },
        "spec_sha256": {
          "$ref": "#/$defs/digest"
        },
        "approval": {
          "type": "object",
          "properties": {
            "human": {
              "type": "string",
              "minLength": 1
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            },
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d\\d-\\d\\d$"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "sha256": {
              "$ref": "#/$defs/digest"
            }
          },
          "required": [
            "human",
            "evidence",
            "date",
            "revision",
            "sha256"
          ],
          "additionalProperties": true
        },
        "task_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "recorded_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "required": [
        "spec_revision",
        "spec_sha256",
        "approval",
        "task_ids",
        "recorded_at"
      ],
      "additionalProperties": true
    }
  }
}
